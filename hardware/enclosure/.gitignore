# CAD toolchain venv (recreate: python3.12 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/
__pycache__/

# scratch scripts (underscore-prefixed, per repo convention)
_*.py

# Generated outputs are not tracked. CI builds them from these sources
# (hardware/build.sh), uploads them as an artifact on every PR, and attaches
# them to a GitHub release when a fab-* tag is pushed. The exact files sent on
# an order are that release's assets; see hardware/MANUFACTURING.md.
out/
segno_panel_layout.svg
